#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export PATH="$HOME/.local/bin:$PATH"
command="${1:-}"
case "$command" in
  transcript|report|playlist|ask|links) shift ;;
  *) echo "usage: yt transcript|report|playlist|ask|links …" >&2; exit 2 ;;
esac
for candidate in "${YOUTUBE_SKILL_PYTHON:-}" python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
  [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
    exec "$candidate" -I "$here/$command.py" "$@"
  fi
done
if command -v uv >/dev/null 2>&1; then
  exec uv run -q --no-project --python 3.12 python -I "$here/$command.py" "$@"
fi
echo "Python 3.10 or newer not found: run install.sh, or install uv then run \"uv python install 3.12\"." >&2
exit 1
